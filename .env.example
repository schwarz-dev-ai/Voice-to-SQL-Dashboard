# Copy to .env and fill in your workshop key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides. These set the *initial* selection; both are switchable in the UI.
# UI_LANGUAGE=en
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Speech-to-text. Pin the spoken language - a wrong choice fails silently.
# WHISPER_LANGUAGE=en
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
