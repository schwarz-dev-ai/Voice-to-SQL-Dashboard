# --- LLM backend ---------------------------------------------------------
# Set the key for whichever provider you use. text_to_sql.py picks OpenRouter when
# its key is present and Anthropic otherwise; LLM_PROVIDER forces the choice.
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_PROVIDER=openrouter          # anthropic | openrouter

# Model per provider. A trailing ":nitro" on an OpenRouter id asks for the fastest
# upstream instead of the default routing.
# CLAUDE_MODEL=claude-opus-5-5
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Anthropic only: reasoning depth (low ... max).
# CLAUDE_EFFORT=low

# --- Interface ----------------------------------------------------------
# These set the *initial* selection; both are switchable in the UI.
# UI_LANGUAGE=en

# Speech-to-text. Pin the spoken language - a wrong choice fails silently.
# WHISPER_LANGUAGE=en
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
